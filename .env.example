# ------------------------------------------------------------------
# SSO Lab - environment variables (placeholders only)
# Next.js loads a real ".env" file automatically. Everything in here
# is server-side configuration; nothing below is exposed to the browser.
# Phase 1: no values needed yet. Fill them in during Phase 2/3:
#   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# ------------------------------------------------------------------

# --- Keycloak (Identity Provider) -----------------------------------
# Base URL of the local Keycloak started by Docker Compose (port 8080).
KEYCLOAK_BASE_URL=http://localhost:8080

# The realm we create in Phase 2. A realm is Keycloak's "tenant":
# it has its own users, settings, and clients.
KEYCLOAK_REALM=sso-lab

# OIDC client (application) registration created in Phase 2/3.
KEYCLOAK_CLIENT_ID=sso-lab-nextjs
KEYCLOAK_CLIENT_SECRET=In48dk2TORETp2JM01djszwoUvb130sG64G0XwEZ7ryfPxqTbxSPjLv8vQrA6nVCFNQjZPEt78bm01M8NgoUdd

# --- Application session (Phase 3) ----------------------------------
# The lab keeps sessions in a server-side in-memory Map (lib/session.ts),
# so no extra secret is needed. Production alternatives (Redis, Postgres)
# are discussed in Phase 6.
